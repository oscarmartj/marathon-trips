{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh api repos/oscarmartj/marathon-trips/pulls/*/merge *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./secrets/**)",
      "Bash(vercel *)",
      "Bash(flyctl *)",
      "Bash(fly *)",
      "Bash(railway *)",
      "Bash(render *)",
      "Bash(wrangler *)"
    ]
  }
}
