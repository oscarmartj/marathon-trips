{
  "name": "@mt/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma scripts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run --config vitest.config.mts --reporter=default --reporter=json --outputFile=test-results/vitest.json",
    "test:sandbox": "vitest run --config vitest.sandbox.config.mts --reporter=default --reporter=json --outputFile=test-results/sandbox.json && tsx scripts/sandbox-evidence.ts test-results/sandbox.json",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/seed.ts",
    "gen:field-classes": "tsx scripts/gen-field-classes.ts",
    "cli": "tsx src/cli.ts",
    "e2e:staff": "tsx scripts/e2e-staff.ts"
  },
  "dependencies": {
    "@mt/shared": "workspace:*",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie": "^1.1.1",
    "nodemailer": "10.5.0",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pg-boss": "12.38.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "4.1.12",
    "yaml": "^2.9.1"
  }
}
