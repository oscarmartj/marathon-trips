// Customers and booking requests (task 2.4; plan docs/plans/2.4-booking-requests.md and plan 0.1, 5.4).
// No money moves here: a request stores the engine's price in an immutable snapshot and holds stock.
// CHECKs, triggers and partial indexes live in the migration 0014_bookings.

enum BookingStatus {
  requested
  approved
  deposit_paid
  confirmed
  balance_paid
  completed
  declined
  expired
  cancelled
  refunded
}

enum BookingKind {
  catalogue
  bespoke
}

enum BookingSourceChannel {
  web
  panel
  api
}

enum CustomerSource {
  web
  panel
}

enum BookingSnapshotKind {
  original
  amendment
}

/// Who asked for a change of a booking (task 6.3).
enum BookingAmendmentInitiator {
  customer
  staff
}

/// Why staff changed a booking (task 6.3): a code, never free text (notes on the booking hold any detail).
enum BookingAmendmentReason {
  customer_request
  correction
  supplier_change
  other
}

/// What a change of a booking changed (task 6.3), derived by the server from the two configurations.
enum BookingAmendmentChange {
  room
  nights
  travellers_added
  travellers_removed
  participation
  extras
}

enum InventoryClaimStatus {
  held
  released
}

/// A person who books (plan 0.1, 5.4; minimal in 2.4). One per email address; linked to the customer User that
/// verified the address. Personal data: erased by 5.5 through the entity registry.
model Customer {
  id                 String            @id @default(uuid(7)) @db.Uuid
  userId             String?           @unique @db.Uuid
  /// @nopii always customer (CHECK): only a customer user can be linked
  userKind           UserKind          @default(customer)
  user               User?             @relation(fields: [userId, userKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  /// @pii contact address, copied from the verified customer user
  email              String            @unique @db.Citext
  /// @pii
  givenName          String
  /// @pii
  familyName         String
  /// @pii
  phone              String?
  /// @pii country of residence (ISO 3166-1 alpha-2); ZZ once erased
  countryOfResidence String            @db.Char(2)
  /// @nopii BCP 47 locale of the site the customer used
  preferredLocale    String            @default("en-AU")
  /// @nopii how the record was created
  source             CustomerSource
  /// @nopii set when the personal data was erased
  anonymisedAt       DateTime?         @db.Timestamptz(3)
  /// @pii custom fields are free text
  customFields       Json              @default("{}")
  /// @nopii demo data root (plan 0.1, 1.3)
  isDemo             Boolean           @default(false)
  /// @nopii optimistic lock for the admin panel
  version            Int               @default(0)
  /// @nopii soft delete
  deletedAt          DateTime?         @db.Timestamptz(3)
  deletedById        String?           @db.Uuid
  /// @nopii timestamp
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  bookings           Booking[]
  quotes             Quote[]
  promoRedemptions   PromoRedemption[]
  termsAcceptances    TermsAcceptance[]
  payments           Payment[]
  waitlistEntries    WaitlistEntry[]
  complaints         Complaint[]
  privacyRequests    PrivacyRequest[]
  consentRecords     ConsentRecord[]

  @@unique([userId, userKind])
  @@map("customers")
}

/// A booking request and, later, the booking (plan 0.1, 5.4 and 6.2). Its status only changes through
/// BookingStateMachine and the allowed pairs of a trigger; its totals always mirror its current snapshot. Never deleted.
model Booking {
  id                     String               @id @default(uuid(7)) @db.Uuid
  /// @nopii human reference MT-XXXXXX, random (Crockford base32)
  reference              String               @unique
  customerId             String               @db.Uuid
  customer               Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii catalogue or bespoke
  kind                   BookingKind
  packageId              String               @db.Uuid
  package                Package              @relation(fields: [packageId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  editionId              String               @db.Uuid
  edition                RaceEdition          @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii state of the booking (plan 0.1, 6.2)
  status                 BookingStatus
  /// @nopii version of the snapshot in force
  currentSnapshotVersion Int
  /// @nopii calendar date, extra nights included
  departureDate          DateTime             @db.Date
  /// @nopii calendar date, extra nights included
  returnDate             DateTime             @db.Date
  /// @nopii ISO 4217
  currency               String               @db.Char(3)
  /// @nopii minor units, in `currency`; mirrors the current snapshot
  totalMinor             BigInt
  /// @nopii minor units, in `currency`; mirrors the current snapshot
  depositMinor           BigInt
  /// @nopii calendar date
  balanceDueDate         DateTime             @db.Date
  /// @pii country of residence declared with the request; ZZ once erased
  residenceCountry       String               @db.Char(2)
  /// @nopii timestamp
  requestedAt            DateTime             @db.Timestamptz(3)
  /// @nopii timestamp
  requestExpiresAt       DateTime             @db.Timestamptz(3)
  /// @nopii timestamp
  approvedAt             DateTime?            @db.Timestamptz(3)
  /// @nopii timestamp (swept by 3.2)
  approvalExpiresAt      DateTime?            @db.Timestamptz(3)
  /// @nopii timestamp
  declinedAt             DateTime?            @db.Timestamptz(3)
  /// @nopii timestamp
  expiredAt              DateTime?            @db.Timestamptz(3)
  /// @nopii timestamp
  cancelledAt            DateTime?            @db.Timestamptz(3)
  /// @pii staff reason for the last decline or cancellation, free text
  statusReason           String?
  /// @nopii where the request came from
  sourceChannel          BookingSourceChannel
  /// @secret SHA-256 of the user id and the client's Idempotency-Key: one booking per key and customer
  requestKeyHash         String               @db.Char(64)
  /// @secret SHA-256 of the requested configuration and code (no personal data)
  requestConfigHash      String               @db.Char(64)
  /// @secret HMAC of the contact details sent with the request; NULL once erased
  requestContactHmac     String?              @db.Char(64)
  /// @nopii demo data root (plan 0.1, 1.3)
  isDemo                 Boolean              @default(false)
  /// @pii custom fields are free text
  customFields           Json                 @default("{}")
  /// @nopii optimistic lock for the admin panel
  version                Int                  @default(0)
  /// @nopii timestamp
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)
  snapshots              BookingSnapshot[]
  quote                  Quote?
  travellers             BookingTraveller[]
  rooms                  BookingRoom[]
  extras                 BookingExtra[]
  claims                 InventoryClaim[]
  promoRedemptions       PromoRedemption[]
  paymentSchedules       PaymentSchedule[]
  payments               Payment[]
  webhookEvents          WebhookEvent[]
  termsAcceptances       TermsAcceptance[]
  paymentLinks           PaymentLink[]
  ledgerTransactions     LedgerTransaction[]
  inventoryMovements     InventoryMovement[]
  complaints             Complaint[]
  waitlistEntries        WaitlistEntry[]
  travellerDetails       Traveller[]
  amendments             BookingAmendment[]
  cancellations          Cancellation[]
  cancellationRequest    CancellationRequest?

  @@unique([id, currency])
  @@unique([id, customerId])
  @@unique([customerId, requestKeyHash])
  @@index([customerId, status])
  @@index([packageId, status])
  @@index([editionId, status])
  @@index([status, requestExpiresAt])
  @@map("bookings")
}

/// The configuration and price of a booking as submitted (version 1) or amended (6.3). Never changes: UPDATE, DELETE and
/// TRUNCATE are refused by triggers (not marked append-only, because it points at bookings; plan 2.4, section 2.2).
/// No personal data and no free text: travellers are slots, everything else ids, codes, dates and amounts.
model BookingSnapshot {
  id             String              @id @default(uuid(7)) @db.Uuid
  bookingId      String              @db.Uuid
  booking        Booking             @relation(fields: [bookingId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii 1 for the request; each amendment adds one
  version        Int
  /// @nopii original or amendment
  kind           BookingSnapshotKind
  /// @nopii PricedConfiguration from the engine: ids, slots and counts only (bookingSnapshotSchema)
  configuration  Json
  /// @nopii PriceBreakdown from the engine: lines, totals, rule trace (ids and outcomes); no free text
  priceBreakdown Json
  /// @nopii minor units, in `currency`
  totalMinor     BigInt
  /// @nopii minor units, in `currency`
  depositMinor   BigInt
  /// @nopii ISO 4217
  currency       String              @db.Char(3)
  priceVersionId String              @db.Uuid
  priceVersion   PriceVersion        @relation(fields: [priceVersionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii engine version that priced it
  engineVersion  String
  /// The cancellation policy the booking was sold under (task 6.4): set at the request, copied by every amendment
  cancellationPolicyId String?          @db.Uuid
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii timestamp
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([bookingId, version])
  @@index([priceVersionId])
  @@map("booking_snapshots")
}

/// A place in a booking (plan 0.1, 5.4). Exists from the request; the traveller's personal data arrives with 5.2.
model BookingTraveller {
  id                String            @id @default(uuid(7)) @db.Uuid
  bookingId         String            @db.Uuid
  customerId        String            @db.Uuid
  booking           Booking           @relation(fields: [bookingId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii 1-based place in the order of rooms and travellers
  slot              Int
  /// @nopii catalogue data
  participationType ParticipationType
  raceDistanceId    String?           @db.Uuid
  raceDistance      RaceDistance?     @relation(fields: [raceDistanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the customer's own place
  isLead            Boolean           @default(false)
  /// @nopii snapshot version that added the place
  addedInVersion    Int               @default(1)
  /// @nopii snapshot version that removed the place (6.3)
  removedInVersion  Int?

  @@unique([bookingId, slot])
  @@index([customerId])
  @@index([raceDistanceId])
  @@map("booking_travellers")
}

/// A room of the booking (operations); the snapshot keeps what was priced. As it stands: `removedInVersion` is null
/// (task 6.3: a change marks the old rows removed and adds the new set; rows are never deleted).
model BookingRoom {
  id               String     @id @default(uuid(7)) @db.Uuid
  bookingId        String     @db.Uuid
  booking          Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roomOptionId     String     @db.Uuid
  roomOption       RoomOption @relation(fields: [roomOptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii people in the room, 1 to 4
  occupancy        Int
  /// @nopii traveller slots in the room
  travellerSlots   Int[]
  /// @nopii snapshot version that added the row
  addedInVersion   Int        @default(1)
  /// @nopii snapshot version that removed the row (6.3)
  removedInVersion Int?

  @@index([bookingId])
  @@index([roomOptionId])
  @@map("booking_rooms")
}

/// An extra of the booking: one row per traveller for per-person extras, one row with a quantity otherwise. As it stands:
/// `removedInVersion` is null (task 6.3).
model BookingExtra {
  id               String  @id @default(uuid(7)) @db.Uuid
  bookingId        String  @db.Uuid
  booking          Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  extraId          String  @db.Uuid
  extra            Extra   @relation(fields: [extraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii how many
  quantity         Int
  /// @nopii traveller slot for a per-person extra
  travellerSlot    Int?
  /// @nopii snapshot version that added the row
  addedInVersion   Int     @default(1)
  /// @nopii snapshot version that removed the row (6.3)
  removedInVersion Int?

  @@unique([bookingId, extraId, travellerSlot, addedInVersion], map: "booking_extras_booking_extra_slot_key")
  @@index([extraId])
  @@map("booking_extras")
}

/// Places a booking holds in a stock pool (plan 0.1, 5.4). Released once (held → released), never deleted.
model InventoryClaim {
  id              String               @id @default(uuid(7)) @db.Uuid
  bookingId       String?              @db.Uuid
  booking         Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the waiting list entry whose offer holds the places (task 6.5); exactly one of booking and entry owns a claim
  waitlistEntryId String?              @db.Uuid
  waitlistEntry   WaitlistEntry?       @relation(fields: [waitlistEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  poolId          String               @db.Uuid
  pool            InventoryPool        @relation(fields: [poolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii places held
  quantity        Int
  /// @nopii held or released
  status          InventoryClaimStatus @default(held)
  /// @nopii timestamp
  releasedAt      DateTime?            @db.Timestamptz(3)
  /// @nopii snapshot version whose configuration the claim holds stock for (task 6.3: a change of quantity releases the
  /// claim and takes a new one; at most one held claim per booking and pool, EXCLUDE in 0029)
  snapshotVersion Int                  @default(1)
  /// @nopii timestamp
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([bookingId, poolId, snapshotVersion])
  @@unique([waitlistEntryId, poolId])
  @@index([poolId, status])
  @@map("inventory_claims")
}

/// A change of a booking after its deposit (task 6.3; plan docs/plans/6.3-booking-amendments.md). Each row is one applied
/// change: it moved the booking from snapshot `fromVersion` to `toVersion` and records what that did to the money at that
/// moment (history; screens show the current values derived from the plan and the payments). Append-only, no personal
/// data and no free text; written in the same transaction as its snapshot (deferred triggers in 0029).
model BookingAmendment {
  id                  String                    @id @default(uuid(7)) @db.Uuid
  bookingId           String                    @db.Uuid
  /// @nopii ISO 4217, the booking's
  currency            String                    @db.Char(3)
  booking             Booking                   @relation(fields: [bookingId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii snapshot version before the change
  fromVersion         Int
  /// @nopii snapshot version the change created (fromVersion + 1)
  toVersion           Int
  /// @nopii customer or staff
  initiatedBy         BookingAmendmentInitiator
  /// the user who made the change (a customer or a member of staff)
  actorUserId         String                    @db.Uuid
  /// @nopii why
  reasonCode          BookingAmendmentReason
  /// @nopii what changed
  changes             BookingAmendmentChange[]
  /// @nopii minor units, in `currency`: the total of snapshot fromVersion
  previousTotalMinor  BigInt
  /// @nopii minor units, in `currency`: the total of snapshot toVersion
  newTotalMinor       BigInt
  /// @signed minor units, in `currency`: newTotalMinor − previousTotalMinor, from the pricing engine's totals
  priceDifferenceMinor BigInt
  /// @nopii minor units, in `currency`: succeeded payments when the change was made
  collectedMinor      BigInt
  /// @nopii minor units, in `currency`: what was left to pay after the change
  outstandingMinor    BigInt
  /// @nopii minor units, in `currency`: paid beyond the new total after the change (parked: no refund until 4.5)
  creditPendingMinor  BigInt
  /// @signed minor units, in `currency`: re-pricing the unchanged configuration on the basis minus its stored total; ≤ 0 and
  /// only with reasonCode correction (plan, decision 4)
  basisDriftMinor     BigInt                    @default(0)
  basisPriceVersionId String                    @db.Uuid
  basisPriceVersion   PriceVersion              @relation(fields: [basisPriceVersionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the instant the engine prices this booking at (its first pricing; plan, decision 3)
  basisAt             DateTime                  @db.Timestamptz(3)
  /// @secret SHA-256 of the user id and the client's Idempotency-Key: one change per key and booking
  requestKeyHash      String                    @db.Char(64)
  /// @secret SHA-256 of the request body (no personal data)
  requestBodyHash     String                    @db.Char(64)
  /// @nopii timestamp
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)

  @@unique([bookingId, toVersion])
  @@unique([bookingId, requestKeyHash])
  @@index([basisPriceVersionId])
  @@map("booking_amendments")
}

// ---- Cancellations (task 6.4, plan docs/plans/6.4-cancellation-policies.md, sections 2, 5, 6 and 13) ----

enum CancellationRequestedBy {
  customer
  staff
}

/// Why a cancellation owes what it owes (plan 6.4, decision 3 and section 13, M3).
enum CancellationBasis {
  policy
  not_contracted
  no_policy
  operator_cancelled
}

/// One cancellation of a booking, with what the policy said and what it left owed and refundable at that moment
/// (history: screens show the current money from the plan and the payments). Immutable, no personal data and no free
/// text (the reason is the booking's statusReason and the audit log); one per booking.
model Cancellation {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  bookingId             String                  @unique @db.Uuid
  /// @nopii ISO 4217, the booking's
  currency              String                  @db.Char(3)
  booking               Booking                 @relation(fields: [bookingId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii customer or staff
  requestedBy           CancellationRequestedBy
  /// the user who cancelled (a customer or a member of staff)
  requestedById         String                  @db.Uuid
  /// @nopii the booking's state when it was cancelled
  bookingStatus         BookingStatus
  /// @nopii snapshot version in force when it was cancelled
  snapshotVersion       Int
  /// @nopii policy, not_contracted, no_policy or operator_cancelled
  basis                 CancellationBasis
  cancellationPolicyId  String?                 @db.Uuid
  cancellationPolicy    CancellationPolicy?     @relation(fields: [cancellationPolicyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the first blocked request whose date this cancellation kept (section 13, M4)
  cancellationRequestId String?                 @unique @db.Uuid
  cancellationRequest   CancellationRequest?    @relation(fields: [cancellationRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii calendar date (Brisbane) the days are counted from: the request's, within the hold window, or processedDate
  businessDate          DateTime                @db.Date
  /// @nopii calendar date (Brisbane) it was processed
  processedDate         DateTime                @db.Date
  /// @signed whole days from businessDate to the departure date; negative after departure
  daysBeforeDeparture   Int
  /// @nopii threshold of the tier that applied; null unless basis is policy
  tierMinDays           Int?
  /// @nopii the policy's tiers and the chosen tier as applied (ids, thresholds, modes, amounts; strict schema)
  policySnapshot        Json
  /// @nopii minor units, in `currency`: the booking total the penalty is based on (current snapshot)
  baseTotalMinor        BigInt
  /// @nopii traveller places of the current snapshot
  places                Int
  /// @signed minor units, in `currency`: what was held when it was cancelled (collected, disputed money excluded)
  collectedMinor        BigInt
  /// @nopii minor units, in `currency`: what the policy says
  policyPenaltyMinor    BigInt
  /// @nopii minor units, in `currency`: what the booking keeps owing (min of the policy penalty and what was held)
  penaltyMinor          BigInt
  /// @nopii minor units, in `currency`: the part of the policy penalty never charged (decision 5)
  waivedMinor           BigInt
  /// @nopii minor units, in `currency`: what may go back as cancellation refunds (cap of P10)
  refundableMinor       BigInt
  /// @nopii timestamp
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  refunds               Refund[]

  @@unique([id, bookingId])
  @@index([cancellationPolicyId])
  @@map("cancellations")
}

/// The first cancellation attempt refused while money was moving (plan 6.4, section 13, M4): its date holds for a
/// fixed window. Immutable, one per booking, no personal data.
model CancellationRequest {
  id            String                  @id @default(uuid(7)) @db.Uuid
  bookingId     String                  @unique @db.Uuid
  booking       Booking                 @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii customer or staff
  requestedBy   CancellationRequestedBy
  /// the user who asked
  requestedById String                  @db.Uuid
  /// @nopii calendar date (Brisbane) of the attempt
  businessDate  DateTime                @db.Date
  /// @nopii code of what blocked it
  blockedReason String
  /// @nopii digest of the quote the requester saw
  quoteDigest   String                  @db.Char(64)
  /// @nopii timestamp
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  cancellation  Cancellation?

  @@map("cancellation_requests")
}
