// Payments core (task 3.1; plan docs/plans/3.1-payment-provider-core.md and plan 0.1, 5.5), with the ledger and gateway
// refunds of task 3.3 (plan docs/plans/3.3-stripe-adapter-ledger.md). No disputes, receipts, GST, FX or supplier
// payments here. Only test-mode accounts exist until a task manages live ones (CHECK). CHECKs and triggers live in the
// migrations 0017_payments and 0033_ledger_refunds.

enum PaymentMode {
  test
  live
}

enum ProviderAccountStatus {
  active
  paused
  retired
  archived
}

enum PaymentScheduleItemKind {
  deposit
  balance
  instalment
  adjustment
  /// task 6.4: what a cancelled booking keeps owing
  penalty
}

enum PaymentScheduleItemState {
  active
  waived
  superseded
}

enum PaymentOrigin {
  collection
  manual_intent
  inbound
}

enum PaymentMethod {
  card
  apple_pay
  google_pay
  payto
  becs
  payid_transfer
  bpay
  bnpl
  manual_other
}

enum PaymentStatus {
  created
  pending
  requires_action
  succeeded
  failed
  cancelled
  expired
  voided
}

/// A payment link's state (task 5.1): a link serves once. Expiry is not stored: it is expiresAt <= now.
enum PaymentLinkStatus {
  active
  used
  revoked
}

/// Who started a refund (task 3.3): `external` was made on the gateway's own dashboard; `app` comes with task 4.5.
enum RefundOrigin {
  app
  external
}

/// Why a refund is made (plan 0.1, P9). An external refund has none.
enum RefundPurpose {
  price_reduction
  overpayment_return
  cancellation
}

/// The refund state machine (plan 0.1, 6.2): forward only; pairs in a trigger of migration 0033.
enum RefundStatus {
  requested
  pending
  succeeded
  failed
  reversed
}

enum LedgerAccountKind {
  asset
  liability
  revenue
  expense
}

/// What a ledger transaction records (plan 0.1, 5.5).
enum LedgerTransactionKind {
  payment
  refund
  fee
  chargeback
  supplier_payment
  adjustment
  reversal
}

enum ProviderWebhookEventStatus {
  received
  processed
  ignored
  failed
}

enum ProviderWebhookRejectionReason {
  bad_signature
  stale_timestamp
  malformed
}

/// An account with a payment gateway (plan 0.1, 5.5; managed from the panel since 4.1). Credentials and the webhook secret
/// are encrypted at rest and only ProviderGateway decrypts them. Test mode only (CHECK) until a later task, gated on a
/// verified adapter and Oscar's approval, lifts it. Never deleted.
model ProviderAccount {
  id                       String                @id @default(uuid(7)) @db.Uuid
  /// @nopii key of the adapter in the code registry
  adapterKey               String
  /// @pii free text typed by staff
  displayName              String
  /// @nopii test or live; never changes (trigger); test only (CHECK, kept by 4.1)
  mode                     PaymentMode
  /// @nopii
  status                   ProviderAccountStatus @default(active)
  /// @secret AES-256-GCM ciphertext of the adapter's credentials (AAD provider_account:<id>:credentials)
  credentialsCiphertext    String
  /// @nopii version of APP_ENCRYPTION_KEY that encrypted the credentials
  credentialsKeyVersion    Int
  /// @secret AES-256-GCM ciphertext of the webhook signing secret (AAD provider_account:<id>:webhook_secret); null until
  /// entered for an adapter whose gateway issues it (Stripe), task 4.1
  webhookSecretCiphertext  String?
  /// @nopii version of APP_ENCRYPTION_KEY that encrypted the webhook secret; null with it
  webhookKeyVersion        Int?
  /// @nopii when the credentials or the webhook secret last changed: a connection test counts only if not older (4.1)
  credentialsChangedAt     DateTime              @default(now()) @db.Timestamptz(3)
  /// @nopii why a paused account is paused: staff, boot_adapter_missing or boot_adapter_planned (CHECK); null otherwise
  pauseReasonCode          String?
  /// @secret HMAC of the webhook path token with AUTH_HMAC_KEY; the full URL is shown once
  webhookPathTokenHash     String                @unique @db.Char(64)
  /// @nopii
  lastConnectionTestAt     DateTime?             @db.Timestamptz(3)
  /// @nopii code: ok or the adapter's error code
  lastConnectionTestResult String?
  createdById              String?               @db.Uuid
  /// @nopii optimistic lock for the admin panel
  version                  Int                   @default(0)
  /// @nopii timestamp
  createdAt                DateTime              @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt                DateTime              @updatedAt @db.Timestamptz(3)
  payments                 Payment[]
  webhookEvents            WebhookEvent[]
  webhookRejections        WebhookRejection[]
  routingRules             RoutingRule[]
  settlements              Settlement[]
  reconciliationRuns       ReconciliationRun[]
  health                   ProviderAccountHealth?

  @@unique([id, mode])
  @@map("provider_accounts")
}

/// The payment plan of a booking (plan 0.1, 5.5): created with the approval in the same transaction, never deleted;
/// `version` goes up with every change. The amounts of its items come from the booking's current snapshot.
model PaymentSchedule {
  id        String                @id @default(uuid(7)) @db.Uuid
  bookingId String                @unique @db.Uuid
  /// @nopii ISO 4217, the booking's
  currency  String                @db.Char(3)
  booking   Booking               @relation(fields: [bookingId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii goes up by one with every change of the plan
  version   Int                   @default(1)
  /// @nopii timestamp
  createdAt DateTime              @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt DateTime              @updatedAt @db.Timestamptz(3)
  items     PaymentScheduleItem[]

  @@unique([id, bookingId, currency])
  @@map("payment_schedules")
}

/// One instalment of a payment plan. Never edited: a change supersedes it and creates new items (plan 0.1, 5.10).
model PaymentScheduleItem {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  scheduleId          String                   @db.Uuid
  bookingId           String                   @db.Uuid
  /// @nopii ISO 4217, the booking's
  currency            String                   @db.Char(3)
  schedule            PaymentSchedule          @relation(fields: [scheduleId, bookingId, currency], references: [id, bookingId, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii deposit, balance, instalment or adjustment
  kind                PaymentScheduleItemKind
  /// @nopii order of the item in its plan version, from 1
  sequence            Int
  /// @nopii version of the plan that created the item
  planVersion         Int
  /// @nopii minor units, in `currency`, from the booking's snapshot
  amountMinor         BigInt
  /// @nopii calendar date in the business time zone
  dueDate             DateTime                 @db.Date
  /// @nopii active, waived or superseded
  state               PaymentScheduleItemState @default(active)
  /// @nopii plan version that superseded the item
  supersededInVersion Int?
  /// @nopii timestamp
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  payments            Payment[]
  paymentLinks        PaymentLink[]

  @@unique([id, bookingId, currency])
  @@unique([id, bookingId])
  @@unique([scheduleId, planVersion, sequence])
  @@index([bookingId, state])
  @@map("payment_schedule_items")
}

/// A payment attempt (plan 0.1, 5.5 and 6.2). Its amount comes from the server (plan, snapshot); its status only moves
/// through the attempt state machine and the pairs of a trigger; at most one live attempt per booking (liveBookingId).
model Payment {
  id                   String              @id @default(uuid(7)) @db.Uuid
  bookingId            String              @db.Uuid
  /// @nopii ISO 4217, the booking's
  currency             String              @db.Char(3)
  booking              Booking             @relation(fields: [bookingId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii collection, manual_intent (a transfer the customer said they would make) or inbound (a transfer staff confirmed)
  origin               PaymentOrigin
  /// @nopii 1, 2, … per booking
  attemptNumber        Int
  /// null only for an inbound transfer when no plan item is left to pay
  targetScheduleItemId String?             @db.Uuid
  targetScheduleItem   PaymentScheduleItem? @relation(fields: [targetScheduleItemId, bookingId, currency], references: [id, bookingId, currency], onDelete: Restrict, onUpdate: Restrict)
  payerCustomerId      String              @db.Uuid
  payerCustomer        Customer            @relation(fields: [payerCustomerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  providerAccountId    String              @db.Uuid
  /// @nopii test or live, the account's
  mode                 PaymentMode
  providerAccount      ProviderAccount     @relation(fields: [providerAccountId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii key of the adapter that served the attempt
  adapterKey           String
  /// @nopii the method the customer chose; never changes the amount
  method               PaymentMethod
  /// @nopii minor units, in `currency`, computed by the server
  amountMinor          BigInt
  /// @nopii state of the attempt (plan 3.1, section 5.2)
  status               PaymentStatus
  /// @nopii set to bookingId while the attempt is live (created, requires_action, pending), else NULL: one live attempt per booking
  liveBookingId        String?             @unique @db.Uuid
  /// @nopii booking:<id>:attempt:<n>, generated by the server and sent to the gateway as its idempotency key
  idempotencyKey       String              @unique
  /// @nopii the gateway's object id; for an inbound transfer, the bank statement's movement id (unique per account unless voided)
  providerPaymentRef   String?
  /// @nopii what the payer writes on the transfer: the booking's reference (it only finds the booking)
  payerReference       String?
  /// @nopii code from the gateway's closed list
  failureCode          String?
  /// @nopii when the sweep asks the gateway about an unfinished attempt; never extended
  pendingExpiresAt     DateTime            @db.Timestamptz(3)
  /// @nopii timestamp
  succeededAt          DateTime?           @db.Timestamptz(3)
  /// @nopii bumped with every change
  version              Int                 @default(0)
  /// the payment link the attempt was started through (task 5.1); null for checkout; never changes
  paymentLinkId        String?             @db.Uuid
  paymentLink          PaymentLink?        @relation(fields: [paymentLinkId, bookingId], references: [id, bookingId], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii timestamp
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)
  webhookEvents        WebhookEvent[]
  refunds              Refund[]
  disputes             Dispute[]
  ledgerTransactions   LedgerTransaction[]
  receipts             Receipt[]
  settlementMatches    SettlementLineMatch[]

  @@unique([id, bookingId, currency])
  @@unique([id, mode])
  @@unique([id, bookingId, providerAccountId, mode, currency])
  /// Task 4.6: a receipt carries its payment's booking, mode, currency and amount.
  @@unique([id, bookingId, mode, currency, amountMinor])
  @@unique([bookingId, attemptNumber])
  @@index([providerAccountId, providerPaymentRef])
  @@index([status, pendingExpiresAt])
  @@index([payerCustomerId])
  @@index([targetScheduleItemId])
  @@index([paymentLinkId])
  @@map("payments")
}

/// A gateway webhook that passed its signature check, stored raw (plan 0.1, 5.5). The body is personal data: emptied
/// when the customer is erased and after 180 days. Never deleted.
model WebhookEvent {
  id                String                     @id @default(uuid(7)) @db.Uuid
  providerAccountId String                     @db.Uuid
  providerAccount   ProviderAccount            @relation(fields: [providerAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the gateway's event id
  providerEventId   String
  bookingId         String?                    @db.Uuid
  booking           Booking?                   @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentId         String?                    @db.Uuid
  payment           Payment?                   @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// the refund the event was matched to (task 3.3)
  refundId          String?                    @db.Uuid
  refund            Refund?                    @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// the dispute the event was matched to (task 4.5)
  disputeId         String?                    @db.Uuid
  dispute           Dispute?                   @relation(fields: [disputeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the gateway's event type (payment.updated…)
  type              String
  /// @pii the body as received (can carry the payer's details)
  rawBody           Bytes?
  /// @nopii allow-listed headers, signature values removed
  headers           Json
  /// @nopii timestamp
  receivedAt        DateTime                   @default(now()) @db.Timestamptz(3)
  /// @nopii
  status            ProviderWebhookEventStatus @default(received)
  /// @nopii processing attempts
  attempts          Int                        @default(0)
  /// @nopii timestamp
  processedAt       DateTime?                  @db.Timestamptz(3)
  /// @nopii code only
  errorCode         String?
  /// @nopii timestamp
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)

  @@unique([providerAccountId, providerEventId])
  @@index([status, receivedAt])
  @@index([bookingId])
  @@index([paymentId])
  @@index([refundId])
  @@index([disputeId])
  @@map("webhook_events")
}

/// A webhook for a known account that failed its signature, timestamp or format check. No body; purged after 30 days.
/// Oversized requests and unknown paths are only counted in memory (plan 3.1, section 14, point 5).
model WebhookRejection {
  id                String                         @id @default(uuid(7)) @db.Uuid
  providerAccountId String                         @db.Uuid
  providerAccount   ProviderAccount                @relation(fields: [providerAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii timestamp
  receivedAt        DateTime                       @default(now()) @db.Timestamptz(3)
  /// @nopii
  reason            ProviderWebhookRejectionReason
  /// @nopii SHA-256 of the body, to match retries
  bodySha256        String                         @db.Char(64)
  /// @nopii
  sizeBytes         Int
  /// @nopii event id the body claimed, if it could be read
  claimedEventId    String?
  /// @nopii allow-listed headers, signature values removed
  headers           Json

  @@index([receivedAt])
  @@index([providerAccountId, receivedAt])
  @@map("webhook_rejections")
}

/// The booking terms a customer accepted before paying (task 3.5, plan docs/plans/3.5-checkout-simulator.md, section 2).
/// The content page is edited in place, so the accepted text is kept here as a snapshot. Never edited or deleted (trigger
/// in migration 0023); one row per booking and exact text.
model TermsAcceptance {
  id             String   @id @default(uuid(7)) @db.Uuid
  bookingId      String   @db.Uuid
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// who accepted: the booking's customer, read inside the same transaction
  customerId     String   @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii content page address, such as terms
  documentSlug   String
  /// @nopii language tag such as en-AU
  locale         String
  /// @nopii version counter of the content page when it was accepted
  contentVersion Int
  /// @nopii SHA-256 (hex) of the canonical JSON of slug, locale, title, intro and body
  textDigest     String   @db.Char(64)
  /// @nopii editorial text as accepted
  title          String
  /// @nopii editorial text as accepted
  intro          String
  /// @nopii editorial text as accepted
  body           String
  /// @nopii digest of the cancellation policy shown with the terms (task 6.4); null when the booking has none
  cancellationPolicyDigest String? @db.Char(64)
  /// @nopii timestamp
  acceptedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([bookingId, documentSlug, locale, textDigest])
  @@map("terms_acceptances")
}

/// A payment link (task 5.1, plan docs/plans/5.1-customer-area.md, section 5): a single-use capability that staff send to
/// the booking's own address to pay one plan item without a session. No amount (P1): the server computes it. The token
/// is minted in the email's send step and only its SHA-256 is kept. Updates are limited by a trigger (migration 0025).
model PaymentLink {
  id                   String              @id @default(uuid(7)) @db.Uuid
  bookingId            String              @db.Uuid
  booking              Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// the plan item the link pays up to: next payable when it was sent
  targetScheduleItemId String              @db.Uuid
  targetScheduleItem   PaymentScheduleItem @relation(fields: [targetScheduleItemId, bookingId], references: [id, bookingId], onDelete: Restrict, onUpdate: Restrict)
  /// @secret SHA-256 (hex) of the token; null until the email is sent
  tokenHash            String?             @unique @db.Char(64)
  /// @nopii active, used or revoked
  status               PaymentLinkStatus   @default(active)
  /// @nopii timestamp
  expiresAt            DateTime            @db.Timestamptz(3)
  /// staff user who sent it (UUID without a foreign key, like audit actors)
  createdById          String              @db.Uuid
  /// @nopii timestamp
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  usedAt               DateTime?           @db.Timestamptz(3)
  /// @nopii timestamp
  revokedAt            DateTime?           @db.Timestamptz(3)
  payments             Payment[]

  @@unique([id, bookingId])
  @@index([bookingId, status])
  @@map("payment_links")
}

/// A refund of a payment (plan 0.1, 5.5 and 6.2; task 3.3). In 3.3 only refunds made on the gateway's dashboard exist
/// (origin external, CHECK until task 4.5). Its status only moves through the refund state machine and a trigger.
model Refund {
  id                String            @id @default(uuid(7)) @db.Uuid
  paymentId         String            @db.Uuid
  bookingId         String            @db.Uuid
  providerAccountId String            @db.Uuid
  /// @nopii test or live, the payment's
  mode              PaymentMode
  /// @nopii ISO 4217, the payment's
  currency          String            @db.Char(3)
  payment           Payment           @relation(fields: [paymentId, bookingId, providerAccountId, mode, currency], references: [id, bookingId, providerAccountId, mode, currency], onDelete: Restrict, onUpdate: Restrict, map: "refunds_payment_fkey")
  /// @nopii minor units, in `currency`, as the gateway reports it
  amountMinor       BigInt
  /// @nopii app or external
  origin            RefundOrigin
  /// @nopii null for an external refund
  purpose           RefundPurpose?
  /// the cancellation a refund with purpose cancellation belongs to (task 6.4; same booking by the foreign key)
  cancellationId    String?           @db.Uuid
  cancellation      Cancellation?     @relation(fields: [cancellationId, bookingId], references: [id, bookingId], onDelete: Restrict, onUpdate: Restrict, map: "refunds_cancellation_fkey")
  /// @pii free text from staff (task 4.5); erased with the customer
  reason            String?
  /// @nopii
  status            RefundStatus
  /// @nopii refund:external:<accountId>:<gateway ref> for an external refund; generated by the server
  idempotencyKey    String            @unique
  /// @nopii the gateway's refund id
  providerRefundRef String?
  /// @nopii code from the gateway's closed list
  failureCode       String?
  requestedById     String?           @db.Uuid
  /// @nopii timestamp
  succeededAt       DateTime?         @db.Timestamptz(3)
  /// @nopii bumped with every change of status
  version           Int               @default(0)
  /// @nopii true for the refund of a bank transfer (task 4.5): staff send it from the bank and confirm it with its reference
  manualRefund      Boolean           @default(false)
  /// @secret the account a manual refund goes to, encrypted; only while requested (task 4.5, P13)
  destinationCiphertext String?
  /// @nopii key version of destinationCiphertext
  destinationKeyVersion Int?
  /// @pii masked destination of a manual refund (last digits); erased with the customer
  destinationHint   String?
  /// staff who confirmed a manual refund
  confirmedById     String?           @db.Uuid
  confirmedBy       User?             @relation("RefundConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii when an unanswered gateway request is tried again with the same key (task 4.5)
  nextAttemptAt     DateTime?         @db.Timestamptz(3)
  /// @nopii how many times the gateway request was sent
  requestAttempts   Int               @default(0)
  /// @nopii while the gateway request is being sent (or staff resolve it): nobody else sends or resolves (review, H1)
  sendingUntil      DateTime?         @db.Timestamptz(3)
  /// @nopii timestamp
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  webhookEvents     WebhookEvent[]
  ledgerTransactions LedgerTransaction[]
  receiptNotes      ReceiptNote[]
  settlementMatches SettlementLineMatch[]

  @@unique([id, mode])
  @@unique([providerAccountId, providerRefundRef])
  @@index([paymentId])
  @@index([bookingId])
  @@index([cancellationId])
  @@index([status, updatedAt])
  @@index([nextAttemptAt])
  @@map("refunds")
}

/// The state of a dispute (task 4.5, plan 0.1, 6.2): forward only; won, lost and closed are final (trigger of 0035).
enum DisputeStatus {
  open
  evidence_submitted
  won
  lost
  closed
}

/// A dispute (chargeback) a gateway reported on one of our payments (task 4.5). Its money moves only with the funds
/// postings (withdrawn, reinstated), once each. Never deleted; no personal data (the evidence package is built on demand).
model Dispute {
  id                    String        @id @default(uuid(7)) @db.Uuid
  paymentId             String        @db.Uuid
  bookingId             String        @db.Uuid
  providerAccountId     String        @db.Uuid
  /// @nopii test or live, the payment's
  mode                  PaymentMode
  /// @nopii ISO 4217, the payment's
  currency              String        @db.Char(3)
  payment               Payment       @relation(fields: [paymentId, bookingId, providerAccountId, mode, currency], references: [id, bookingId, providerAccountId, mode, currency], onDelete: Restrict, onUpdate: Restrict, map: "disputes_payment_fkey")
  /// @nopii the gateway's dispute id
  providerDisputeRef    String
  /// @nopii minor units, in `currency`, as the gateway reports it
  amountMinor           BigInt
  /// @nopii closed list (fraudulent, product_not_received…)
  reasonCode            String
  /// @nopii
  status                DisputeStatus
  /// @nopii timestamp
  evidenceDueBy         DateTime?     @db.Timestamptz(3)
  /// @nopii timestamp
  evidenceSubmittedAt   DateTime?     @db.Timestamptz(3)
  evidenceSubmittedById String?       @db.Uuid
  evidenceSubmittedBy   User?         @relation("DisputeEvidenceSubmittedBy", fields: [evidenceSubmittedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii when the withdrawal was posted
  fundsWithdrawnAt      DateTime?     @db.Timestamptz(3)
  /// @nopii when the reinstatement was posted
  fundsReinstatedAt     DateTime?     @db.Timestamptz(3)
  /// @nopii bumped with every change
  version               Int           @default(0)
  /// @nopii timestamp
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  webhookEvents         WebhookEvent[]
  ledgerTransactions    LedgerTransaction[]
  receiptNotes          ReceiptNote[]
  settlementMatches     SettlementLineMatch[]

  @@unique([id, mode])
  @@unique([providerAccountId, providerDisputeRef])
  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
  @@map("disputes")
}

/// An account of the ledger (plan 0.1, 5.5; task 3.3), created on demand and never changed. Test and live never share one.
/// @appendOnly
model LedgerAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  /// @nopii provider_clearing:<accountId>, customer_funds, customer_overpayments, customer_receivable…
  code      String
  /// @nopii
  kind      LedgerAccountKind
  /// @nopii ISO 4217
  currency  String            @db.Char(3)
  /// @nopii
  mode      PaymentMode
  /// @nopii timestamp
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  entries   LedgerEntry[]

  @@unique([code, currency, mode])
  @@map("ledger_accounts")
}

/// One fact of the ledger (plan 0.1, 5.5; task 3.3): append-only, with at least two entries summing to 0 per currency,
/// all inserted in the database transaction that created it (triggers in migration 0033). A correction is a new
/// transaction (reversal or adjustment). Only LedgerService writes here.
model LedgerTransaction {
  id                    String                @id @default(uuid(7)) @db.Uuid
  /// @nopii timestamp
  occurredAt            DateTime              @default(now()) @db.Timestamptz(3)
  /// @nopii
  kind                  LedgerTransactionKind
  /// @nopii test or live
  mode                  PaymentMode
  bookingId             String?               @db.Uuid
  booking               Booking?              @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentId             String?               @db.Uuid
  payment               Payment?              @relation(fields: [paymentId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  refundId              String?               @db.Uuid
  refund                Refund?               @relation(fields: [refundId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  reversesTransactionId String?               @db.Uuid
  disputeId             String?               @db.Uuid
  dispute               Dispute?              @relation(fields: [disputeId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  /// task 6.2: the supplier payment this posting records or reverses (never with a booking)
  supplierPaymentId     String?               @db.Uuid
  supplierPayment       SupplierPayment?      @relation(fields: [supplierPaymentId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  reverses              LedgerTransaction?    @relation("LedgerReversal", fields: [reversesTransactionId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  reversedBy            LedgerTransaction[]   @relation("LedgerReversal")
  /// @nopii one per business fact (plan 0.1, P5): payment:<id>:succeeded, refund:<id>:succeeded…
  idempotencyKey        String                @unique
  /// @nopii a code such as reallocation
  description           String
  /// @nopii SHA-256 of the canonical content, to tell a retry from a different posting under the same key
  contentSha256         String                @db.Char(64)
  /// @nopii pg_current_xact_id() of the database transaction that created it, set by a trigger
  createdTxId           BigInt?
  entries               LedgerEntry[]

  @@unique([id, mode])
  @@unique([reversesTransactionId])
  @@index([bookingId])
  @@index([paymentId])
  @@index([refundId])
  @@index([disputeId])
  @@index([supplierPaymentId])
  @@map("ledger_transactions")
}

/// One line of a ledger transaction: positive is a debit, negative a credit (task 3.3). Never edited or deleted (triggers;
/// not tagged as an append-only model only because its transaction points at payments, which are updated).
model LedgerEntry {
  id            String            @id @default(uuid(7)) @db.Uuid
  transactionId String            @db.Uuid
  /// @nopii test or live, the transaction's and the account's
  mode          PaymentMode
  transaction   LedgerTransaction @relation(fields: [transactionId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii code of the account
  accountCode   String
  /// @nopii ISO 4217, the account's
  currency      String            @db.Char(3)
  account       LedgerAccount     @relation(fields: [accountCode, currency, mode], references: [code, currency, mode], onDelete: Restrict, onUpdate: Restrict)
  /// @signed minor units in `currency`: positive debit, negative credit, never 0
  amountMinor   BigInt
  /// the transaction's booking, copied so balances per booking are one index away
  bookingId     String?           @db.Uuid
  /// @nopii timestamp
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  @@index([transactionId])
  @@index([bookingId, accountCode])
  @@index([accountCode, currency, mode])
  @@map("ledger_entries")
}

/// The kinds of PayID a transfer can be sent to (task 3.4).
enum PayIdType {
  email
  phone
  abn
  org_id
}

/// How a manual payment method is offered (plan 0.1 5.5, task 3.4, plan docs/plans/3.4-manual-payid-transfer.md): switched
/// on or off, the countries it is offered in, the words shown to the customer and the business's own payee details. Editing
/// needs step-up and is audited. The payee details are the business's, not a customer's.
model PaymentMethodConfig {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// @nopii payid_transfer or manual_other
  method        PaymentMethod @unique
  /// @nopii
  enabled       Boolean       @default(false)
  /// @nopii ISO 3166 alpha-2 codes of the customers' countries of residence it is offered to
  countries     String[]
  /// @nopii
  displayOrder  Int           @default(0)
  /// @nopii LocalizedText shown with the instructions
  instructions  Json?
  /// @nopii the account holder's name
  payeeName     String?
  /// @nopii
  payIdType     PayIdType?
  /// @nopii the business's PayID
  payId         String?
  /// @nopii six digits
  bsb           String?       @db.Char(6)
  /// @nopii the business's account number
  accountNumber String?
  /// @nopii optimistic lock for the admin panel
  version       Int           @default(0)
  updatedById   String?       @db.Uuid
  /// @nopii timestamp
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@map("payment_method_configs")
}

/// Which account takes a new payment (task 4.2, plan docs/plans/4.2-routing-rules.md): method, customer's country,
/// booking currency, inclusive limits in that currency, priority (lower first) and an optional primary rule this one
/// backs up (one level, same method and currency, another account; trigger in 0036). Rules only filter where a
/// server-computed amount may be charged: they never change it. Editing needs step-up and is audited.
model RoutingRule {
  id                String          @id @default(uuid(7)) @db.Uuid
  providerAccountId String          @db.Uuid
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii
  method            PaymentMethod
  /// @nopii ISO 3166 alpha-2 codes of the customers' countries of residence; null means any country (never empty)
  countries         String[]
  /// @nopii true when the rule serves every country (countries is then empty)
  anyCountry        Boolean         @default(true)
  /// @nopii ISO 4217: the booking currency it serves; its limits are in it
  currency          String          @db.Char(3)
  /// @nopii inclusive lower limit, minor units of currency
  minAmountMinor    BigInt?
  /// @nopii inclusive upper limit, minor units of currency
  maxAmountMinor    BigInt?
  /// @nopii 0..1000, lower first
  priority          Int             @default(100)
  /// @nopii
  enabled           Boolean         @default(true)
  /// the primary rule this one backs up (null: a primary rule)
  fallbackForRuleId String?         @db.Uuid
  fallbackFor       RoutingRule?    @relation("RoutingRuleFallback", fields: [fallbackForRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fallbacks         RoutingRule[]   @relation("RoutingRuleFallback")
  /// @nopii optimistic lock for the admin panel
  version           Int             @default(0)
  createdById       String?         @db.Uuid
  updatedById       String?         @db.Uuid
  /// @nopii timestamp; default rules take their account's, so ties keep the account order of task 3.1
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@index([currency, method, enabled])
  @@index([providerAccountId])
  @@index([fallbackForRuleId])
  @@map("payment_routing_rules")
}

/// Whether a gateway account answers (task 4.2, plan section 3 and 15.2): a circuit breaker fed only by the gateway
/// wrapper. It decides which account takes a new attempt; it never changes an account's status or an attempt.
model ProviderAccountHealth {
  providerAccountId   String          @id @db.Uuid
  providerAccount     ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii failures in a row since the last success
  consecutiveFailures Int             @default(0)
  /// @nopii timestamp
  lastFailureAt       DateTime?       @db.Timestamptz(3)
  /// @nopii provider_unavailable, provider_timeout or provider_auth_failed (CHECK)
  lastFailureCode     String?
  /// @nopii when the breaker opened, cleared by a success
  openedAt            DateTime?       @db.Timestamptz(3)
  /// @nopii skipped for new attempts until then; 9999-12-31 after provider_auth_failed (no automatic half-open)
  openUntil           DateTime?       @db.Timestamptz(3)
  /// @nopii while half-open: the one probe attempt holds it until then
  probeUntil          DateTime?       @db.Timestamptz(3)
  /// @nopii timestamp
  lastSuccessAt       DateTime?       @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt           DateTime        @default(now()) @db.Timestamptz(3)

  @@map("provider_account_health")
}

// ---- Task 4.6: settlements, reconciliation and receipts (plan docs/plans/4.6-reconciliation-receipts.md) ----
// CHECKs, guards and grants live in migration 0037. Nothing here holds personal data.

/// What a line of a gateway settlement (payout) is.
enum SettlementLineKind {
  charge
  refund
  dispute_withdrawal
  dispute_reinstatement
  adjustment
  other
}

enum ReconciliationRunStatus {
  running
  matched
  mismatch
  partial
  failed
  not_applicable
}

enum ReconciliationTrigger {
  scheduled
  manual
}

/// What a note records about the receipt it references (plan 4.6, section 4.1).
enum ReceiptNoteKind {
  refund
  refund_reversal
  chargeback
  chargeback_reinstatement
  void
}

enum ReceiptNoteDirection {
  decrease
  increase
}

/// A settlement (payout) as the gateway reported it, stored once and never changed (guard of 0037).
model Settlement {
  id                    String            @id @default(uuid(7)) @db.Uuid
  providerAccountId     String            @db.Uuid
  /// @nopii test or live, the account's
  mode                  PaymentMode
  account               ProviderAccount   @relation(fields: [providerAccountId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the gateway's payout id
  providerSettlementRef String
  /// @nopii calendar date the gateway paid out
  payoutDate            DateTime          @db.Date
  /// @nopii ISO 4217, the payout's
  currency              String            @db.Char(3)
  /// @signed minor units, everything the lines move
  grossMinor            BigInt
  /// @signed minor units, the gateway's fees (negative when it gave fees back)
  feesMinor             BigInt
  /// @signed minor units, gross less fees (negative when the gateway took money)
  netMinor              BigInt
  /// @nopii SHA-256 of the settlement as imported: a later listing with other content is a difference
  contentSha256         String
  /// @nopii timestamp
  importedAt            DateTime          @default(now()) @db.Timestamptz(3)
  lines                 SettlementLine[]

  @@unique([providerAccountId, providerSettlementRef])
  @@unique([id, mode, currency])
  @@map("settlements")
}

/// One line of a settlement. The gateway's references only; what it matches is in SettlementLineMatch.
model SettlementLine {
  id              String              @id @default(uuid(7)) @db.Uuid
  settlementId    String              @db.Uuid
  /// @nopii the settlement's
  mode            PaymentMode
  /// @nopii ISO 4217, the settlement's
  currency        String              @db.Char(3)
  settlement      Settlement          @relation(fields: [settlementId, mode, currency], references: [id, mode, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the gateway's id for the line
  providerLineRef String
  /// @nopii
  kind            SettlementLineKind
  /// @signed minor units moved by the line (a refund is negative)
  amountMinor     BigInt
  /// @signed minor units, the gateway's fee on the line
  feeMinor        BigInt
  /// @nopii the gateway's payment reference, if any
  paymentRef      String?
  /// @nopii the gateway's refund reference, if any
  refundRef       String?
  /// @nopii the gateway's dispute reference, if any
  disputeRef      String?
  /// @nopii timestamp
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  matches         SettlementLineMatch[]

  @@unique([settlementId, providerLineRef])
  @@unique([id, mode])
  @@map("settlement_lines")
}

/// What a settlement line was matched to, written once (at import or on a later run). Lines stay immutable.
model SettlementLineMatch {
  id        String         @id @default(uuid(7)) @db.Uuid
  lineId    String         @unique @db.Uuid
  /// @nopii the line's
  mode      PaymentMode
  line      SettlementLine @relation(fields: [lineId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the line's kind (one match per object and kind: code review M1)
  kind      SettlementLineKind
  paymentId String?        @db.Uuid
  payment   Payment?       @relation(fields: [paymentId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  refundId  String?        @db.Uuid
  refund    Refund?        @relation(fields: [refundId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  disputeId String?        @db.Uuid
  dispute   Dispute?       @relation(fields: [disputeId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  /// the booking of what it matched (checked by the guard of 0037)
  bookingId String         @db.Uuid
  /// @nopii timestamp
  matchedAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([paymentId])
  @@index([refundId])
  @@index([disputeId])
  @@index([bookingId])
  @@map("settlement_line_matches")
}

/// One reconciliation of one gateway account for one day. Closed once (status, counts and differences), then immutable.
model ReconciliationRun {
  id                String                  @id @default(uuid(7)) @db.Uuid
  providerAccountId String                  @db.Uuid
  /// @nopii the account's
  mode              PaymentMode
  account           ProviderAccount         @relation(fields: [providerAccountId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii Brisbane calendar date the run is for
  forDate           DateTime                @db.Date
  /// @nopii 1 for the first run of the day, then 2, 3…
  attempt           Int
  /// @nopii
  trigger           ReconciliationTrigger
  /// staff who asked for it (manual runs); the audit log names them too
  triggeredById     String?                 @db.Uuid
  /// @nopii
  status            ReconciliationRunStatus @default(running)
  /// @nopii closed list (provider_unavailable, stale_run…)
  errorCode         String?
  /// @nopii how many of our objects and gateway items were compared
  checkedObjects    Int                     @default(0)
  /// @nopii codes, entity ids, statuses and amounts only (validated before it is written)
  differences       Json                    @default("[]")
  /// @nopii timestamp
  startedAt         DateTime                @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  finishedAt        DateTime?               @db.Timestamptz(3)

  @@unique([providerAccountId, forDate, attempt])
  @@index([status])
  @@map("reconciliation_runs")
}

/// The one numbering of receipts and notes, per mode (MT-T-… in test, MT-R-… live): a number is used once, by one document.
model ReceiptNumber {
  /// @nopii the document number
  number    String       @id
  /// @nopii
  mode      PaymentMode
  /// @nopii receipt or note
  kind      String
  /// @nopii timestamp
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  receipt   Receipt?
  note      ReceiptNote?

  @@map("receipt_numbers")
}

/// A receipt: one per payment collected, issued once from its ledger posting and never changed (no GST while not registered).
model Receipt {
  id                   String        @id @default(uuid(7)) @db.Uuid
  /// @nopii the document number
  number               String        @unique
  numbering            ReceiptNumber @relation(fields: [number], references: [number], onDelete: Restrict, onUpdate: Restrict)
  bookingId            String        @db.Uuid
  paymentId            String        @unique @db.Uuid
  /// @nopii the payment's
  mode                 PaymentMode
  /// @nopii ISO 4217, the payment's
  currency             String        @db.Char(3)
  /// @nopii minor units, the payment's amount
  amountMinor          BigInt
  payment              Payment       @relation(fields: [paymentId, bookingId, mode, currency, amountMinor], references: [id, bookingId, mode, currency, amountMinor], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the ledger posting it records (payment:<id>:succeeded)
  causeKey             String        @unique
  /// @nopii minor units in customer_funds after the posting (the base of GST once it can be switched on)
  fundsAfterMinor      BigInt
  /// @nopii always false in task 4.6 (GST registration cannot be switched on yet)
  gstRegisteredAtIssue Boolean       @default(false)
  /// @nopii exactly what is printed: no customer name, email or address
  content              Json
  /// @nopii the fixed layout that prints it
  layoutVersion        Int
  /// @nopii SHA-256 of the content
  contentSha256        String
  /// @nopii timestamp
  issuedAt             DateTime      @default(now()) @db.Timestamptz(3)
  notes                ReceiptNote[]

  @@unique([id, bookingId, mode, currency])
  @@index([bookingId])
  @@map("receipts")
}

/// A note about a receipt (refund, reversal, chargeback, reinstatement, void), issued once from its ledger posting.
model ReceiptNote {
  id                   String               @id @default(uuid(7)) @db.Uuid
  /// @nopii the document number
  number               String               @unique
  numbering            ReceiptNumber        @relation(fields: [number], references: [number], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii
  kind                 ReceiptNoteKind
  /// @nopii
  direction            ReceiptNoteDirection
  receiptId            String               @db.Uuid
  bookingId            String               @db.Uuid
  /// @nopii the receipt's
  mode                 PaymentMode
  /// @nopii ISO 4217, the receipt's
  currency             String               @db.Char(3)
  receipt              Receipt              @relation(fields: [receiptId, bookingId, mode, currency], references: [id, bookingId, mode, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii minor units the note records
  amountMinor          BigInt
  refundId             String?              @db.Uuid
  refund               Refund?              @relation(fields: [refundId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  disputeId            String?              @db.Uuid
  dispute              Dispute?             @relation(fields: [disputeId, mode], references: [id, mode], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the ledger posting it records
  causeKey             String               @unique
  /// @nopii minor units in customer_funds after the posting
  fundsAfterMinor      BigInt
  /// @nopii always false in task 4.6
  gstRegisteredAtIssue Boolean              @default(false)
  /// @nopii exactly what is printed: no customer name, email or address
  content              Json
  /// @nopii the fixed layout that prints it
  layoutVersion        Int
  /// @nopii SHA-256 of the content
  contentSha256        String
  /// @nopii timestamp
  issuedAt             DateTime             @default(now()) @db.Timestamptz(3)

  @@index([receiptId])
  @@index([bookingId])
  @@map("receipt_notes")
}
