// Pricing (task 2.1, plan docs/plans/2.1-pricing-engine.md; plan 0.1, section 5.3). Rules, promo codes, their
// redemptions and scheduled versions are task 2.2 (plan docs/plans/2.2-pricing-rules-promo-codes.md). The CHECK constraints, the EXCLUDE that keeps published versions of a package from
// overlapping, NULLS NOT DISTINCT and the immutability triggers are SQL in the migration (Prisma cannot express them).

enum PriceVersionStatus {
  draft
  published
  archived
}

/// A set of rates for one package. A draft is edited freely; a published version is frozen (only its validTo is set,
/// once, when a successor is published); archived is a discarded draft. Published versions of a package never overlap.
model PriceVersion {
  id                 String              @id @default(uuid(7)) @db.Uuid
  packageId          String              @db.Uuid
  /// @nopii ISO 4217; always the package's (composite foreign key) and never changed
  currency           String              @db.Char(3)
  package            Package             @relation(fields: [packageId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii staff label, never personal data
  label              String
  /// @nopii catalogue data
  status             PriceVersionStatus  @default(draft)
  /// @nopii null while draft
  validFrom          DateTime?           @db.Timestamptz(3)
  /// @nopii null = open-ended
  validTo            DateTime?           @db.Timestamptz(3)
  /// @nopii timestamp
  publishedAt        DateTime?           @db.Timestamptz(3)
  publishedById      String?             @db.Uuid
  /// @nopii optimistic lock for the admin panel; setting rates bumps it
  version            Int                 @default(0)
  /// @nopii the price terms of the package's extras when published (ids and enums only); the open gate compares them
  /// with the catalogue so a total never changes without a new version (plan 2.2, section 6). Null while draft.
  pricedTerms        Json?
  /// @nopii timestamp
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  roomRates          RoomRate[]
  participationRates ParticipationRate[]
  extraRates         ExtraRate[]
  bookingSnapshots   BookingSnapshot[]
  bookingAmendments  BookingAmendment[]
  quotes             Quote[]

  @@unique([id, currency])
  @@index([packageId, status])
  @@map("price_versions")
}

/// Price per person in a room at a given occupancy (every person in the room pays it), and per extra night.
model RoomRate {
  id                       String       @id @default(uuid(7)) @db.Uuid
  priceVersionId           String       @db.Uuid
  /// @nopii ISO 4217, the version's
  currency                 String       @db.Char(3)
  priceVersion             PriceVersion @relation(fields: [priceVersionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  roomOptionId             String       @db.Uuid
  roomOption               RoomOption   @relation(fields: [roomOptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii catalogue data
  occupancy                Int
  /// @nopii minor units, in `currency`
  pricePerPersonMinor      BigInt
  /// @nopii minor units, in `currency`
  extraNightPerPersonMinor BigInt
  /// @nopii timestamp
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([priceVersionId, roomOptionId, occupancy])
  @@index([roomOptionId])
  @@map("room_rates")
}

/// The entry (runner with an entry, by distance) or the participation of a runner with their own entry or a supporter.
model ParticipationRate {
  id                   String            @id @default(uuid(7)) @db.Uuid
  priceVersionId       String            @db.Uuid
  /// @nopii ISO 4217, the version's
  currency             String            @db.Char(3)
  priceVersion         PriceVersion      @relation(fields: [priceVersionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii catalogue data
  participationType    ParticipationType
  /// Set if and only if participationType is runner_with_entry (CHECK in the migration).
  raceDistanceId       String?           @db.Uuid
  raceDistance         RaceDistance?     @relation(fields: [raceDistanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii minor units, in `currency`
  amountPerPersonMinor BigInt
  /// @nopii timestamp
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)

  // NULLS NOT DISTINCT in the migration: one rate per (version, type) when there is no distance.
  @@unique([priceVersionId, participationType, raceDistanceId], map: "participation_rates_version_type_distance_key")
  @@index([raceDistanceId])
  @@map("participation_rates")
}

/// Price of one unit of an extra (per person or per booking, as the extra says).
model ExtraRate {
  id             String       @id @default(uuid(7)) @db.Uuid
  priceVersionId String       @db.Uuid
  /// @nopii ISO 4217, the version's
  currency       String       @db.Char(3)
  priceVersion   PriceVersion @relation(fields: [priceVersionId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  extraId        String       @db.Uuid
  extra          Extra        @relation(fields: [extraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii minor units, in `currency`
  amountMinor    BigInt
  /// @nopii timestamp
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([priceVersionId, extraId])
  @@index([extraId])
  @@map("extra_rates")
}

enum PriceRuleScope {
  global
  edition
  package
}

enum PriceRuleKind {
  early_bird
  late_supplement
  group_discount
  occupancy_supplement
  custom
}

enum PriceRuleDirection {
  discount
  surcharge
}

enum PriceEffectMode {
  percent
  fixed
}

enum PriceEffectPer {
  person
  booking
}

enum PriceEffectTarget {
  accommodation
  participation
  extras
  subtotal
}

/// An automatic adjustment (plan 2.2, section 3): a discount or surcharge that applies when its conditions hold.
/// Never deleted (archived instead); an archived rule never changes. The scope is global, an edition or a package.
model PriceRule {
  id         String             @id @default(uuid(7)) @db.Uuid
  /// @nopii staff label, never personal data
  label      String
  /// @nopii configuration
  scopeType  PriceRuleScope
  /// Set if and only if scopeType is edition (CHECK in the migration).
  editionId  String?            @db.Uuid
  edition    RaceEdition?       @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Set if and only if scopeType is package (CHECK in the migration).
  packageId  String?            @db.Uuid
  package    Package?           @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii configuration
  kind       PriceRuleKind
  /// @nopii configuration
  direction  PriceRuleDirection
  /// @nopii numbers, calendar dates and enums only (ruleConditionsSchema), never free text
  conditions Json               @default("{}")
  /// @nopii configuration
  effectMode PriceEffectMode
  /// @nopii basis points, percent rules only
  valueBps   Int?
  /// @nopii minor units in `currency`, fixed rules only
  valueMinor BigInt?
  /// @nopii ISO 4217, set if and only if valueMinor is
  currency   String?            @db.Char(3)
  /// @nopii configuration
  per        PriceEffectPer
  /// @nopii configuration
  appliesTo  PriceEffectTarget
  /// @nopii configuration
  priority   Int
  /// @nopii configuration
  stackable  Boolean            @default(false)
  /// @nopii configuration
  enabled    Boolean
  /// @nopii inclusive
  validFrom  DateTime?          @db.Timestamptz(3)
  /// @nopii exclusive
  validTo    DateTime?          @db.Timestamptz(3)
  /// @nopii timestamp; an archived rule is never applied or changed again
  archivedAt DateTime?          @db.Timestamptz(3)
  /// @nopii optimistic lock for the admin panel
  version    Int                @default(0)
  /// @nopii timestamp
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)

  @@index([scopeType])
  @@index([editionId])
  @@index([packageId])
  @@map("price_rules")
}

/// A promo code (plan 2.2, section 4): the effect of a rule, always a discount, with usage limits. The code text and
/// the scope never change; a code is never reused, even archived. redeemedCount only moves through redemptions.
model PromoCode {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// @nopii chosen by staff: upper-case letters, digits and hyphens (PROMO_CODE_PATTERN), never personal data
  code           String            @unique @db.Citext
  /// @nopii staff label, never personal data
  label          String
  /// @nopii configuration
  scopeType      PriceRuleScope
  editionId      String?           @db.Uuid
  edition        RaceEdition?      @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  packageId      String?           @db.Uuid
  package        Package?          @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii numbers, calendar dates and enums only (ruleConditionsSchema), never free text
  conditions     Json              @default("{}")
  /// @nopii configuration
  effectMode     PriceEffectMode
  /// @nopii basis points, percent codes only
  valueBps       Int?
  /// @nopii minor units in `currency`, fixed codes only
  valueMinor     BigInt?
  /// @nopii ISO 4217, set if and only if valueMinor is
  currency       String?           @db.Char(3)
  /// @nopii configuration
  per            PriceEffectPer
  /// @nopii configuration
  appliesTo      PriceEffectTarget
  /// @nopii configuration
  stackable      Boolean           @default(false)
  /// @nopii configuration
  enabled        Boolean
  /// @nopii inclusive
  validFrom      DateTime?         @db.Timestamptz(3)
  /// @nopii exclusive
  validTo        DateTime?         @db.Timestamptz(3)
  /// @nopii null = no limit
  maxRedemptions Int?
  /// @nopii null = no limit
  maxPerCustomer Int?
  /// @nopii active redemptions; CHECK 0 ≤ redeemedCount ≤ maxRedemptions
  redeemedCount  Int               @default(0)
  /// @nopii timestamp; an archived code is never applied again
  archivedAt     DateTime?         @db.Timestamptz(3)
  /// @nopii optimistic lock for the admin panel; redemptions do not bump it
  version        Int               @default(0)
  /// @nopii timestamp
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  redemptions    PromoRedemption[]

  @@index([editionId])
  @@index([packageId])
  @@map("promo_codes")
}

/// One use of a code by one booking (plan 2.2, section 8). Only releasedAt (and activeBookingId with it) changes, once.
/// The redemption belongs to the booking's customer: (bookingId, customerId) points at the booking (task 2.4).
model PromoRedemption {
  id              String    @id @default(uuid(7)) @db.Uuid
  promoCodeId     String    @db.Uuid
  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookingId       String    @db.Uuid
  customerId      String    @db.Uuid
  booking         Booking   @relation(fields: [bookingId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// The booking while the redemption is active, null once released: one active redemption per booking (unique).
  activeBookingId String?   @unique @db.Uuid
  /// @nopii timestamp
  redeemedAt      DateTime  @db.Timestamptz(3)
  /// @nopii timestamp; set once
  releasedAt      DateTime? @db.Timestamptz(3)

  @@unique([promoCodeId, bookingId])
  @@index([promoCodeId, customerId])
  @@map("promo_redemptions")
}

// ---- Cancellation policies (task 6.4, plan docs/plans/6.4-cancellation-policies.md, sections 2, 5 and 13) ----

enum CancellationPolicyStatus {
  draft
  active
  archived
}

enum CancellationPenaltyMode {
  percent
  fixed_per_person
  fixed_per_booking
}

/// A tiered cancellation policy. A draft is edited freely; an active policy is frozen (triggers in 0038) and is what
/// a booking is sold under (`BookingSnapshot.cancellationPolicyId`); archived only once no package uses it.
model CancellationPolicy {
  id            String                      @id @default(uuid(7)) @db.Uuid
  /// @nopii staff label, never personal data
  name          String
  /// @nopii LocalizedText shown to customers next to the tiers
  description   Json
  /// @nopii catalogue data
  status        CancellationPolicyStatus    @default(draft)
  /// @nopii ISO 4217 of the fixed tiers; null when every tier is a percentage
  currency      String?                     @db.Char(3)
  /// @nopii timestamp
  activatedAt   DateTime?                   @db.Timestamptz(3)
  activatedById String?                     @db.Uuid
  /// @nopii timestamp
  archivedAt    DateTime?                   @db.Timestamptz(3)
  /// @nopii optimistic lock for the panel
  version       Int                         @default(0)
  /// @nopii timestamp
  createdAt     DateTime                    @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt     DateTime                    @updatedAt @db.Timestamptz(3)
  tiers         CancellationTier[]
  packages      PackageCancellationPolicy[]
  snapshots     BookingSnapshot[]
  cancellations Cancellation[]

  @@index([status])
  @@map("cancellation_policies")
}

/// One tier: applies when the days left before departure are at least `minDaysBeforeDeparture`; the tier at 0 also
/// covers every day after departure. Changed only while its policy is a draft.
model CancellationTier {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  policyId               String                  @db.Uuid
  policy                 CancellationPolicy      @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii whole days, 0 to 3650
  minDaysBeforeDeparture Int
  /// @nopii percent, fixed_per_person or fixed_per_booking
  penaltyMode            CancellationPenaltyMode
  /// @nopii basis points of the booking total (percent only)
  penaltyBps             Int?
  /// @nopii minor units, in `currency` (fixed modes only)
  penaltyMinor           BigInt?
  /// @nopii ISO 4217 (fixed modes only)
  currency               String?                 @db.Char(3)
  /// @nopii timestamp
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)

  @@unique([policyId, minDaysBeforeDeparture])
  @@map("cancellation_tiers")
}

/// The policy a package sells under now. New bookings freeze it in their snapshot; changing it never alters them.
model PackageCancellationPolicy {
  packageId   String             @id @db.Uuid
  /// @nopii ISO 4217, the package's
  currency    String             @db.Char(3)
  package     Package            @relation(fields: [packageId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  policyId    String             @db.Uuid
  policy      CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii optimistic lock for the panel
  version     Int                @default(0)
  updatedById String?            @db.Uuid
  /// @nopii timestamp
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  /// @nopii timestamp
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@index([policyId])
  @@map("package_cancellation_policies")
}
