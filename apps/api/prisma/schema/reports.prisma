// ---- Task 7.7: funnel per race and report builder ----
// Plan: docs/plans/7.7-funnel-report-builder.md. CHECKs, the unique run index and the REVOKEs live in migration 0024.
// Nothing here holds a person or an amount of money: counters, staff-written report names, ids and codes.

enum ReportEntity {
  funnel
  bookings
}

enum ReportRunStatus {
  queued
  skipped
}

/// Anonymous daily counters per race: no address, cookie or session is stored.
model RaceDailyStat {
  raceId      String   @db.Uuid
  race        Race     @relation(fields: [raceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii calendar day in the business time zone
  day         DateTime @db.Date
  /// @nopii visits to the race page
  views       Int      @default(0)
  /// @nopii visits to a package page, where the builder is
  builderUses Int      @default(0)

  @@id([raceId, day])
  @@map("race_daily_stats")
}

model SavedReport {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// @pii free text typed by staff
  name             String
  /// @nopii funnel or bookings
  entity           ReportEntity
  /// @nopii columns, grouping, races and range from the closed catalogue (strict zod schema)
  definition       Json
  /// @nopii { frequency, weekday | dayOfMonth, time } or null (strict zod schema)
  schedule         Json?
  /// @nopii staff user ids; each is checked again when a run is made and when an email is sent
  recipientUserIds String[]     @db.Uuid
  ownerUserId      String       @db.Uuid
  /// @nopii always staff (CHECK)
  ownerKind        UserKind     @default(staff)
  owner            User         @relation(fields: [ownerUserId, ownerKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii occurrences before this instant are never sent (set when the schedule is set or changed)
  scheduleStartedAt DateTime?   @db.Timestamptz(3)
  /// @nopii optimistic lock
  version          Int          @default(0)
  /// @nopii soft delete only (the API role has no DELETE on this table, migration 0024)
  deletedAt        DateTime?    @db.Timestamptz(3)
  /// @nopii
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  /// @nopii
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  runs             ReportRun[]

  @@index([ownerUserId])
  @@map("saved_reports")
}

model ReportRun {
  id           String          @id @default(uuid(7)) @db.Uuid
  reportId     String          @db.Uuid
  report       SavedReport     @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the scheduled instant this run is for
  scheduledFor DateTime        @db.Timestamptz(3)
  /// @nopii queued (emails were queued) or skipped
  status       ReportRunStatus
  /// @nopii code from a closed list
  reasonCode   String?
  /// @nopii how many emails were queued
  emailsQueued Int             @default(0)
  /// @nopii how many recipients were left out
  recipientsSkipped Int        @default(0)
  /// @nopii
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([reportId, scheduledFor])
  @@map("report_runs")
}
