// ---- Task 7.4: automations (trigger, conditions, actions, test mode and run log) ----
// Plan: docs/plans/7.4-automations.md. CHECKs, the partial unique index and the REVOKE of DELETE and TRUNCATE on rules live in migration 0020.
// A rule never moves money or changes permissions: its actions come from a closed list in code (ActionRegistry).

enum AutomationTriggerType {
  event
  schedule
}

enum AutomationRunSource {
  event
  schedule
  manual
}

enum AutomationRunStatus {
  pending
  succeeded
  skipped
  failed
}

model AutomationRule {
  id          String                @id @default(uuid(7)) @db.Uuid
  /// @pii free text typed by staff
  name        String
  /// @nopii event or schedule
  triggerType AutomationTriggerType
  /// @nopii event type from the trigger catalogue in code, such as bookings.booking.requested
  eventType   String?
  /// @nopii { frequency, time, weekdays } validated by a strict zod schema (no free text)
  schedule    Json?
  /// @nopii list of { fact, op, value }: fact keys, operator codes, ids and enum values only (strict zod schema)
  conditions  Json                  @default("[]")
  /// @pii list of actions; a task title or description is free text typed by staff
  actions     Json                  @default("[]")
  /// @nopii
  enabled     Boolean               @default(false)
  /// @nopii new rules start in test mode: runs only simulate their actions
  testMode    Boolean               @default(true)
  /// @nopii when the rule was last switched on; events before it never start a run
  enabledAt   DateTime?             @db.Timestamptz(3)
  ownerUserId String                @db.Uuid
  /// @nopii always staff (CHECK)
  ownerKind   UserKind              @default(staff)
  owner       User                  @relation(fields: [ownerUserId, ownerKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii optimistic lock
  version     Int                   @default(0)
  /// @nopii soft delete only (the API role has no DELETE on this table, migration 0020)
  deletedAt   DateTime?             @db.Timestamptz(3)
  deletedById String?               @db.Uuid
  /// @nopii
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  /// @nopii
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  runs        AutomationRun[]

  @@index([triggerType, eventType])
  @@index([ownerUserId])
  @@map("automation_rules")
}

model AutomationRun {
  id               String              @id @default(uuid(7)) @db.Uuid
  ruleId           String              @db.Uuid
  rule             AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// @nopii the rule version that was executed (or seen at dispatch while pending)
  ruleVersion      Int
  /// @nopii event, schedule or manual (a panel test; always test mode, CHECK)
  source           AutomationRunSource
  /// outbox event id (no foreign key: the outbox is purged)
  triggerEventId   String?             @db.Uuid
  /// @nopii event type of the trigger
  triggerEventType String?
  /// @nopii scheduled time of a schedule run
  scheduledFor     DateTime?           @db.Timestamptz(3)
  /// @nopii entity type the run is about, from the trigger catalogue
  entityType       String?
  entityId         String?             @db.Uuid
  /// @nopii facts snapshotted at dispatch: fact keys with ids, enum values and booleans only (strict zod schema)
  facts            Json?
  /// @nopii a test run only simulates its actions
  testMode         Boolean
  /// @nopii
  status           AutomationRunStatus @default(pending)
  /// @nopii code from a closed list (CHECK)
  reasonCode       String?
  /// @nopii list of { index, action, status, code?, entityType?, entityId? }: codes and ids only, never rendered text
  steps            Json                @default("[]")
  /// @nopii
  attempts         Int                 @default(0)
  /// @nopii
  startedAt        DateTime            @default(now()) @db.Timestamptz(3)
  /// @nopii
  finishedAt       DateTime?           @db.Timestamptz(3)

  @@index([ruleId, startedAt])
  @@index([status, startedAt])
  @@map("automation_runs")
}
