# Copy to .env for local work outside docker compose. Never commit .env or real secrets.
# Everything below is a development-only value.

# Required. One of: development, test, ci, staging, production. The API refuses to start without it.
APP_ENV=development

API_PORT=4000
API_BASE_URL=http://localhost:4000

# The API connects as mt_app (no CREATE). Migrations run as mt_owner.
DATABASE_URL=postgresql://mt_app:mt_app_dev@localhost:5432/marathon_trips
MIGRATION_DATABASE_URL=postgresql://mt_owner:mt_owner_dev@localhost:5432/marathon_trips

# Development mail catcher (docker compose service "mail"); the web UI is http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# Mail reaches real people only when MAIL_MODE=live AND APP_ENV=production. Anywhere else, recipients outside
# MAIL_DEV_ALLOWLIST (comma-separated domains or addresses) are suppressed and logged, never sent.
MAIL_MODE=catch
MAIL_DEV_ALLOWLIST=example.test,example.com

# Keys (at least 32 characters). Development, test and ci have built-in defaults; staging and production must set both.
# EMAIL_HASH_KEY signs unsubscribe links and hashes addresses in the suppression list; FILE_SIGNING_KEY signs file URLs.
# EMAIL_HASH_KEY=
# FILE_SIGNING_KEY=

# Auth (task 0.3). The browser talks only to the web app, which proxies /api to the API; WEB_ORIGIN is the only
# Origin accepted on requests that change data. TRUST_PROXY=false ignores X-Forwarded-For; set it to the proxy in front
# of the API (docker compose uses "uniquelocal" for the web container). COOKIE_SECURE defaults to true outside
# development, test and ci, and cannot be false in staging or production.
WEB_ORIGIN=http://localhost:3000
# Languages the web app serves besides English (Australia), comma separated (task 8.2; registered ones only, see
# apps/web/src/lib/locales.ts). Unset means English only. Set it for the web build and the web container: pages built
# ahead pick up a change within a minute of their next refresh.
# ENABLED_LOCALES=es-ES
TRUST_PROXY=false
# APP_ENCRYPTION_KEY= (base64 of 32 bytes; encrypts TOTP secrets) and AUTH_HMAC_KEY= (recovery codes) are required
# outside development, test and ci. Generate with: openssl rand -base64 32
# APP_ENCRYPTION_KEY=
# AUTH_HMAC_KEY=
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_SIGN_IN_ATTEMPTS_PER_HOUR_PER_CLIENT=30

# Integrations (task 8.4). Outside production, outgoing webhooks go only to these exact origins (scheme://host:port,
# comma separated); everything else is recorded as suppressed. Ignored in production. Limits for API keys.
WEBHOOK_DEV_ALLOWLIST=
API_KEY_RATE_LIMIT_PER_MINUTE=120
API_KEY_FAILED_PER_MINUTE=30
# Booking requests per hour, per customer and per IP (task 2.4).
BOOKING_REQUESTS_PER_HOUR_PER_USER=10
BOOKING_REQUESTS_PER_HOUR_PER_IP=30
# Payment attempts per hour (customer, IP) and gateway webhooks per minute and IP (task 3.1).
PAYMENT_ATTEMPTS_PER_HOUR_PER_USER=10
PAYMENT_ATTEMPTS_PER_HOUR_PER_IP=30
PAYMENT_WEBHOOKS_PER_MINUTE_PER_IP=600

# Files: the filesystem adapter's folder (git-ignored) and the size limit in bytes.
FILE_STORAGE_DIR=./var/files
FILE_MAX_BYTES=10485760

# Background work. "off" starts pg-boss for sending only (tests, one-off scripts); EVENTS_POLL_MS is the outbox poll interval.
JOBS_WORKERS=on
EVENTS_POLL_MS=2000
