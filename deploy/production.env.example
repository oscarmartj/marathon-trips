# Copy to deploy/production.env on the server (it is git-ignored) and
# fill every value. Never commit real values. Generate each secret with: openssl rand -base64 32
# for example www.example.com.au (no https://)
SITE_ADDRESS=
# https:// plus SITE_ADDRESS; the only Origin the API accepts
WEB_ORIGIN=
POSTGRES_ADMIN_PASSWORD=
MT_OWNER_PASSWORD=
MT_APP_PASSWORD=
# at least 32 characters
EMAIL_HASH_KEY=
# at least 32 characters
FILE_SIGNING_KEY=
# base64 of exactly 32 bytes; losing it makes stored TOTP secrets unreadable
APP_ENCRYPTION_KEY=
# at least 32 characters
AUTH_HMAC_KEY=
# Mail stays in "catch" (nothing reaches real people) until Oscar sets a real SMTP service and MAIL_MODE=live.
MAIL_MODE=catch
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587

# API keys and outgoing webhooks (task 8.4). Both stay off until the module.integrations flag is switched on in the
# panel. WEBHOOK_DEV_ALLOWLIST is ignored in production (the API warns at start-up if it is set).
API_KEY_RATE_LIMIT_PER_MINUTE=120
API_KEY_FAILED_PER_MINUTE=30

# Backups (task 8.6, docs/deploy/guide.md). Files live on the server outside the repository; never commit them.
# File holding the backup passphrase (keep a copy outside the server, or the backups cannot be opened)
BACKUP_PASSPHRASE_FILE=/opt/mt-secrets/backup-passphrase
# rclone configuration for the off-server store, and the place to put bundles. Placeholders until the bucket exists.
RCLONE_CONFIG_FILE=/opt/mt-secrets/rclone.conf
BACKUP_REMOTE_KIND=rclone
BACKUP_REMOTE_TARGET=b2:example-bucket/marathon-trips
